# Copy to .env before your first docker compose up. Local development only.
# Change both passwords before first initialization. A later env edit does not
# change credentials stored in an existing mysql_data volume.
MYSQL_PASSWORD=sgu-tour-local-only
MYSQL_ROOT_PASSWORD=sgu-tour-root-local-only
MYSQL_PORT=3307
# Other service credentials remain in .local/<module>.properties; see docs/DOCKER.md.

# Full-stack Docker mode: fill these values before starting all profiles.
CATALOG_INTERNAL_KEY=
AI_ENABLED=true
GROQ_API_KEY=
MAIL_INTERNAL_API_KEY=

# n8n starts with the mail profile; SMTP sending is an explicit separate setting.
# Set true only after configuring a controlled test mailbox and SMTP credentials.
MAIL_ENABLED=false
MAIL_TEST_MODE=true
MAIL_TEST_RECIPIENT=
MAIL_FROM=
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# Optional Google Sign-In: set the same client ID for frontend build and auth.
# GOOGLE_CLIENT_ID=
