# Documentation/example only. Spring does NOT load this file automatically.
# Set these variables in the terminal / IDE run configuration before starting Java.
MAIL_ENABLED=false
MAIL_INTERNAL_API_KEY=
MAIL_TEST_MODE=true
MAIL_TEST_RECIPIENT=you@example.com
MAIL_FROM=you@example.com
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=you@example.com
MAIL_SMTP_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FRONTEND_BASE_URL=http://localhost:5173
MAIL_BRAND=SGU Tour
MAIL_BATCH_SIZE=10
MAIL_MAX_ATTEMPTS=3
MAIL_POLL_DELAY_MS=15000
