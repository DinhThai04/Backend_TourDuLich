# Giữ build context gọn: Dockerfile chỉ cần pom.xml, src/, .mvn và mvnw.
# Thư mục data/ được mount bằng volume lúc chạy (tour_images), không cần trong image.
target/
data/
.git/
.gitignore
.idea/
.vscode/
*.iml
*.log
.DS_Store
.env
.env.*
!.env.example
# Thư mục .local/ chứa các file *.properties override (DB_PASSWORD, JWT, khoá VNPay) — không được vào build context.
.local/
