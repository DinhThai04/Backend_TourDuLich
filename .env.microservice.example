# SGU Tour — Phase 3 Microservice Environment Template
# Copy to .env.microservice and fill with strong random secrets before running:
#   docker compose -f docker-compose.microservice.yml --env-file .env.microservice up -d --build

# Broker & Cache
RABBITMQ_PASSWORD=change-me-rabbitmq-password
REDIS_PASSWORD=change-me-redis-password

# Shared JWT HS256/HS512 Signing Key (>= 64 bytes UTF-8)
JWT_SIGNER_KEY=change-me-64-byte-random-jwt-signing-key-0123456789abcdef0123456789

# 9 Isolated MySQL Databases
MYSQL_ROOT_AUTH_PASSWORD=change-me-root-auth
MYSQL_AUTH_PASSWORD=change-me-auth
MYSQL_ROOT_TOUR_PASSWORD=change-me-root-tour
MYSQL_TOUR_PASSWORD=change-me-tour
MYSQL_ROOT_PRICING_PASSWORD=change-me-root-pricing
MYSQL_PRICING_PASSWORD=change-me-pricing
MYSQL_ROOT_BOOKING_PASSWORD=change-me-root-booking
MYSQL_BOOKING_PASSWORD=change-me-booking
MYSQL_ROOT_PAYMENT_PASSWORD=change-me-root-payment
MYSQL_PAYMENT_PASSWORD=change-me-payment
MYSQL_ROOT_INVOICE_PASSWORD=change-me-root-invoice
MYSQL_INVOICE_PASSWORD=change-me-invoice
MYSQL_ROOT_FILE_PASSWORD=change-me-root-file
MYSQL_FILE_PASSWORD=change-me-file
MYSQL_ROOT_NOTIFICATION_PASSWORD=change-me-root-notification
MYSQL_NOTIFICATION_PASSWORD=change-me-notification
MYSQL_ROOT_REPORTING_PASSWORD=change-me-root-reporting
MYSQL_REPORTING_PASSWORD=change-me-reporting

# Service-to-Service Internal API Keys (>= 32 chars each)
AUTH_INTERNAL_KEY=change-me-auth-internal-key-32-chars-min
BOOKING_INTERNAL_KEY=change-me-booking-internal-key-32-chars-min
PAYMENT_INTERNAL_KEY=change-me-payment-internal-key-32-chars-min
INVOICE_INTERNAL_KEY=change-me-invoice-internal-key-32-chars-min
TOUR_INTERNAL_KEY=change-me-tour-internal-key-32-chars-min
PRICING_INTERNAL_KEY=change-me-pricing-internal-key-32-chars-min
FILE_INTERNAL_KEY=change-me-file-internal-key-32-chars-min
NOTIFICATION_INTERNAL_KEY=change-me-notification-internal-key-32-chars-min
REPORTING_INTERNAL_KEY=change-me-reporting-internal-key-32-chars-min
MAIL_INTERNAL_API_KEY=change-me-mail-internal-key-32-chars-min
CATALOG_INTERNAL_KEY=change-me-catalog-internal-key-32-chars-min

# Third-Party Providers (Sandbox / Production)
VNPAY_TMN_CODE=SANDBOXTMN
VNPAY_HASH_SECRET=change-me-vnpay-hash-secret
MOMO_PARTNER_CODE=MOMOSANDBOX
MOMO_ACCESS_KEY=change-me-momo-access-key
MOMO_SECRET_KEY=change-me-momo-secret-key
CLOUDINARY_CLOUD_NAME=change-me-cloud-name
CLOUDINARY_API_KEY=change-me-cloudinary-api-key
CLOUDINARY_API_SECRET=change-me-cloudinary-api-secret
