# Copy to ai_service/.env and enter the key locally. Never commit .env.
# Run AiServiceApplication in your IDE or: mvn spring-boot:run
# Boot loads ONLY GROQ_API_KEY from .env; process environment takes precedence.
# A configured key enables the model. To disable it use AI_ENABLED=false in the IDE/process environment.
# Model/port/limits remain in application.yml, not this file.
GROQ_API_KEY=
